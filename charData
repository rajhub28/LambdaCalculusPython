# Helper conversion functions
to_church = lambda n: (lambda f: lambda x: x) if n == 0 else (lambda f: lambda x: f(to_church(n - 1)(f)(x)))
to_int = lambda c: c(lambda x: x + 1)(0)

# Church Booleans
#true  = lambda x: lambda y: x
#false = lambda x: lambda y: y
#AND   = lambda p: lambda q: p(q)(false)

# Church Comparisons
#LEQ = lambda m: lambda n: isZero(sub(m)(n))                       # m <= n
#GEQ = lambda m: lambda n: LEQ(n)(m)                               # m >= n
between = lambda low: lambda high: lambda x: AND(geq(x)(low))(leq(x)(high)) # low <= x <= high

# Character Constructors (ASCII Encodings)
# Numbers: '0' (48) to '9' (57)
# Upper:   'A' (65) to 'Z' (90)
# Lower:   'a' (97) to 'z' (122)

CHAR_0 = to_church(48)
CHAR_9 = to_church(57)

CHAR_A = to_church(65)
CHAR_Z = to_church(90)

CHAR_a = to_church(97)
CHAR_z = to_church(122)

# Predicates using ASCII bounds
isDigit = between(CHAR_0)(CHAR_9)
isUpper = between(CHAR_A)(CHAR_Z)
isLower = between(CHAR_a)(CHAR_z)

# Offset value 32
OFFSET_32 = to_church(32)

# Convert uppercase character to lowercase
toLower = lambda c: \
    isUpper(c) \
        (lambda _: add(c)(OFFSET_32)) \
        (lambda _: c) \
    (zero)

# Convert lowercase character to uppercase
toUpper = lambda c: \
    isLower(c) \
        (lambda _: sub(c)(OFFSET_32)) \
        (lambda _: c) \
    (zero)

# Example characters
char_A = to_church(65)  # 'A'
char_g = to_church(103) # 'g'
char_5 = to_church(53)  # '5'

to_py_bool = lambda b: b(True)(False)

# Tests
print(to_py_bool(isUpper(char_A))) # True
print(to_py_bool(isLower(char_A))) # False
print(to_py_bool(isDigit(char_5))) # True

# Conversion Test
lower_a = toLower(char_A)
print(to_int(lower_a))            # 97 (ASCII for 'a')

